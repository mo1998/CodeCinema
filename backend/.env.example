# --- service ----------------------------------------------------------------
APP_NAME=codecinema-backend
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- datastores -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codecinema
# The SQLite URL is handy for local experiments:
# DATABASE_URL=sqlite+aiosqlite:///./codecinema.db
REDIS_URL=redis://localhost:6379/0

# --- auth -------------------------------------------------------------------
# Change this in production (used to sign access tokens).
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=604800
API_KEY_PREFIX=cc
API_KEY_ITERATIONS=120000
# When true every write endpoint requires a bearer credential.
REQUIRE_AUTH=false

# --- storage / urls ---------------------------------------------------------
STORAGE_DIR=/var/lib/codecinema
PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- limits -----------------------------------------------------------------
MAX_EVENTS_PER_REQUEST=5000
MAX_EVENT_PAGE_SIZE=2000
DEFAULT_PAGE_SIZE=40
MAX_PAGE_SIZE=200

# --- rate limiting ----------------------------------------------------------
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SECOND=1

# --- exports ----------------------------------------------------------------
EXPORT_WORKER_ENABLED=true
EXPORT_QUEUE_NAME=codecinema:exports
EXPORT_FFMPEG_BINARY=ffmpeg

# --- websockets -------------------------------------------------------------
WS_HEARTBEAT_SECONDS=15
WS_STATS_INTERVAL_SECONDS=5

# --- misc -------------------------------------------------------------------
AUTO_CREATE_TABLES=false
